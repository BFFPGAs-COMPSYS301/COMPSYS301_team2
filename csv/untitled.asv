on_line_data = readmatrix('on_line_volt.csv');
t = on_line_data(:,1);
v_on = on_line_data(:,2);

off_line_data = readmatrix('off_line_volt.csv');
v_off = off_line_data(:,2);

Fs = 1/mean(diff(t));  % sampling frequency from your time vector

f_center = 120;
bw = 16;               % bandwidth in Hz, adjust to taste (e.g. 58-62 Hz)
f_low  = f_center - bw/2;
f_high = f_center + bw/2;

Wn = [f_low f_high] / (Fs/2);   % normalize to Nyquist

[z, p, k] = butter(4, Wn, 'bandpass');
sos = zp2sos(z, p, k);
v_on_filtered = sosfilt(sos, v_on);   % or filtfilt(sos, g, v) with the gain

v_off_filtered = sosfilt(sos, v_off);


N = length(v_on);
f = (0:N-1)*(Fs/N);
V_on = abs(fft(v_on));
V_off = abs(fft(v_off));
Vf_on = abs(fft(v_on_filtered));
Vf_off = abs(fft(v_off_filtered));

figure(1);
plot(f, V_on); hold on; plot(f, V_off);
xlim([0 500]);
title('Frequency Response of On-Line and Off-Line Voltages');
legend('On-Line Voltage', 'Off-Line Voltage');
xlabel('Frequency (Hz)');

figure(2);
plot(f, Vf_on);
xlim([0 500]);
title('Frequency Response of filtered On-Line Magnitudes');
xlabel('Frequency (Hz)');

figure(3);
plot(f, Vf_off);
xlim([0 500]);
title('Frequency Response of filtered Off-Line Magnitudes');
xlabel('Frequency (Hz)');

figure(4);
plot(f, Vf_on); hold on; plot(f, Vf_off);
xlim([0 500]);
title('Frequency Response of filtered Off-Line vs On-Line Magnitudes');
legend('On-Line Voltage', 'Off-Line Voltage');
xlabel('Frequency (Hz)');

figure(5);
plot(time, Vf_on);
