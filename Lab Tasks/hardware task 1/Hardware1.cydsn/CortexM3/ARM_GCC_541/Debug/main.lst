  32:main.c        **** /*
  33:main.c        ****  * Number of ADC samples captured before USB transmission.
  34:main.c        ****  *
  35:main.c        ****  * At 50 kSamples/s:
  36:main.c        ****  *
  37:main.c        ****  * capture time = 500 / 50000
  38:main.c        ****  *              = 0.01 seconds
  39:main.c        ****  *              = 10 milliseconds
  40:main.c        ****  */
  41:main.c        **** #define BUFFER_SIZE 500u
  42:main.c        **** 
  43:main.c        **** 
  44:main.c        **** /*
  45:main.c        ****  * Array used to store the ADC samples.
  46:main.c        ****  *
  47:main.c        ****  * The ADC produces a 12-bit result from 0 to 4095.
  48:main.c        ****  * A uint16 variable can hold values from 0 to 65535,
  49:main.c        ****  * so it is large enough for each ADC result.
  50:main.c        ****  *
  51:main.c        ****  * volatile is used because the interrupt writes to this
  52:main.c        ****  * array while main() reads from it.
  53:main.c        ****  */
  54:main.c        **** volatile uint16 adcBuffer[BUFFER_SIZE];
  55:main.c        **** 
  56:main.c        **** 
  57:main.c        **** /*
  58:main.c        ****  * Index of the next available location in adcBuffer.
  59:main.c        ****  *
  60:main.c        ****  * It begins at zero and increases after every sample:
  61:main.c        ****  *
  62:main.c        ****  * 0, 1, 2, ..., BUFFER_SIZE - 1
  63:main.c        ****  */
  64:main.c        **** volatile uint16 bufferIndex = 0u;
  65:main.c        **** 
  66:main.c        **** 
  67:main.c        **** /*
  68:main.c        ****  * Flag indicating whether the ADC buffer is full.
  69:main.c        ****  *
  70:main.c        ****  * bufferFull = 0:
  71:main.c        ****  *     The ISR may continue storing ADC samples.
  72:main.c        ****  *
  73:main.c        ****  * bufferFull = 1:
  74:main.c        ****  *     The buffer contains a complete block and is
  75:main.c        ****  *     ready to be sent through USBUART.
  76:main.c        ****  */
  77:main.c        **** volatile uint8 bufferFull = 0u;
  78:main.c        **** 
  79:main.c        **** 
