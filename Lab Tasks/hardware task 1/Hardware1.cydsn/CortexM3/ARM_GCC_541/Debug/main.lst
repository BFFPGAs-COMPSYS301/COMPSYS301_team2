 118:main.c        ****     /*
 119:main.c        ****      * Scale the ADC result for the DAC.
 120:main.c        ****      *
 121:main.c        ****      * ADC configuration:
 122:main.c        ****      *     0 V to 2.048 V
 123:main.c        ****      *     4096 possible codes
 124:main.c        ****      *
 125:main.c        ****      * ADC step size:
 126:main.c        ****      *
 127:main.c        ****      *     2.048 V / 4096 = 0.0005 V
 128:main.c        ****      *                          = 0.5 mV/count
 129:main.c        ****      *
 130:main.c        ****      * DAC configuration:
 131:main.c        ****      *     0 V to 4.080 V
ARM GAS  C:\Users\kkau904\AppData\Local\Temp\ccQNp8uc.s 			page 4


 132:main.c        ****      *     16 mV/count
 133:main.c        ****      *
 134:main.c        ****      * Number of ADC counts per DAC count:
 135:main.c        ****      *
 136:main.c        ****      *     16 mV / 0.5 mV = 32
 137:main.c        ****      *
 138:main.c        ****      * Therefore:
 139:main.c        ****      *
 140:main.c        ****      *     DAC code = ADC code / 32
 141:main.c        ****      *
 142:main.c        ****      * Shifting right by five bits divides an unsigned
 143:main.c        ****      * integer by:
 144:main.c        ****      *
 145:main.c        ****      *     2^5 = 32
 146:main.c        ****      */
 147:main.c        ****     dacValue = (uint8)(adcValue >> 5);
