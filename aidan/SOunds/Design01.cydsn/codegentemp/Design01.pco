# Design01
# 2026-10-18 06:04:30Z

# IO_0@[IOP=(1)][IoId=(0)] is reserved: SWDDebugEnabled
dont_use_io iocell 1 0
# IO_1@[IOP=(1)][IoId=(1)] is reserved: SWDDebugEnabled
dont_use_io iocell 1 1
# IO_3@[IOP=(1)][IoId=(3)] is reserved: SWDDebugEnabled
dont_use_io iocell 1 3
set_location "ClockBlock" clockblockcell -1 -1 0
set_io "M1_IN2(0)" iocell 3 6
set_io "M1_IN1(0)" iocell 3 7
set_io "M2_IN2_1(0)" iocell 12 0
set_io "M2_IN1_1(0)" iocell 12 1
set_location "Net_94" 3 0 0 1
set_location "Net_166" 3 0 0 0
set_location "\PWM_1:PWMHW\" timercell -1 -1 0
set_location "__ONE__" 3 0 0 2
set_location "\PWM_2:PWMHW\" timercell -1 -1 1
