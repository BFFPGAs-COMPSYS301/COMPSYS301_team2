dont_use_io iocell 1 0
dont_use_io iocell 1 1
dont_use_io iocell 1 3
set_location "\PWM_1:PWMUDB:runmode_enable\" macrocell 2 2 0 0
set_location "\PWM_1:PWMUDB:status_2\" macrocell 2 2 0 1
set_location "\PWM_1:PWMUDB:status_0\" macrocell 2 2 1 0
set_location "Net_3" macrocell 2 2 0 2
set_location "\PWM_1:PWMUDB:genblk8:stsreg\" statusicell 2 2 4 
set_location "\PWM_1:PWMUDB:prevCompare1\" macrocell 2 2 0 3
set_location "\PWM_1:PWMUDB:sP16:pwmdp:u1\" datapathcell 2 2 2 
set_location "\PWM_1:PWMUDB:sP16:pwmdp:u0\" datapathcell 3 2 2 
# Note: port 15 is the logical name for port 8
set_io "LED4(0)" iocell 15 0
set_io "LED3(0)" iocell 0 1
set_io "LED2(0)" iocell 0 0
set_io "LED1(0)" iocell 0 6
set_location "\VDAC8_1:viDAC8\" vidaccell -1 -1 1
# Note: port 15 is the logical name for port 8
set_io "LED5(0)" iocell 15 1
set_location "\PWM_1:PWMUDB:genblk1:ctrlreg\" controlcell 2 2 6 
set_io "Vref_DAC1(0)" iocell 2 3
set_io "Vref_DAC2(0)" iocell 3 3
set_location "ClockBlock" clockblockcell -1 -1 0
