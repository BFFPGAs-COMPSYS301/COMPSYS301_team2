    <CYPRESSTAG name="Macrocell listing" icon="FILE_RPT_EQUATION">

    ------------------------------------------------------------
    Macrocell listing
    ------------------------------------------------------------

    MacroCell: Name=\Timeout_1:TimerUDB:status_tc\, Mode=(Combinatorial)
        Total # of inputs        : 2
        Total # of product terms : 1
            Clock Enable: True
        Main Equation            : 1 pterm
        (
              \Timeout_1:TimerUDB:control_7\ * \Timeout_1:TimerUDB:per_zero\
        );
        Output = \Timeout_1:TimerUDB:status_tc\ (fanout=1)

    MacroCell: Name=\Timeout_2:TimerUDB:status_tc\, Mode=(Combinatorial)
        Total # of inputs        : 2
        Total # of product terms : 1
            Clock Enable: True
        Main Equation            : 1 pterm
        (
              \Timeout_2:TimerUDB:control_7\ * \Timeout_2:TimerUDB:per_zero\
        );
        Output = \Timeout_2:TimerUDB:status_tc\ (fanout=1)

    MacroCell: Name=\Timeout_4:TimerUDB:status_tc\, Mode=(Combinatorial)
        Total # of inputs        : 2
        Total # of product terms : 1
            Clock Enable: True
        Main Equation            : 1 pterm
        (
              \Timeout_4:TimerUDB:control_7\ * \Timeout_4:TimerUDB:per_zero\
        );
        Output = \Timeout_4:TimerUDB:status_tc\ (fanout=1)

    MacroCell: Name=\Timeout_3:TimerUDB:status_tc\, Mode=(Combinatorial)
        Total # of inputs        : 2
        Total # of product terms : 1
            Clock Enable: True
        Main Equation            : 1 pterm
        (
              \Timeout_3:TimerUDB:control_7\ * \Timeout_3:TimerUDB:per_zero\
        );
        Output = \Timeout_3:TimerUDB:status_tc\ (fanout=1)

    MacroCell: Name=\Timeout_5:TimerUDB:status_tc\, Mode=(Combinatorial)
        Total # of inputs        : 2
        Total # of product terms : 1
            Clock Enable: True
        Main Equation            : 1 pterm
        (
              \Timeout_5:TimerUDB:control_7\ * \Timeout_5:TimerUDB:per_zero\
        );
        Output = \Timeout_5:TimerUDB:status_tc\ (fanout=1)

    MacroCell: Name=Net_94, Mode=(Combinatorial)
        Total # of inputs        : 1
        Total # of product terms : 1
            Clock Enable: True
        Main Equation            : 1 pterm
        (
              !Net_76
        );
        Output = Net_94 (fanout=1)

    MacroCell: Name=Net_166, Mode=(Combinatorial)
        Total # of inputs        : 1
        Total # of product terms : 1
            Clock Enable: True
        Main Equation            : 1 pterm
        (
              !Net_162
        );
        Output = Net_166 (fanout=1)

    MacroCell: Name=__ONE__, Mode=(Combinatorial)
        Total # of inputs        : 0
        Total # of product terms : 0
            Clock Enable: True
        Main Equation            : 0 pterms
        !(
            0
        );
        Output = __ONE__ (fanout=2)

    MacroCell: Name=Net_207, Mode=(D-Register)
        Total # of inputs        : 2
        Total # of product terms : 1
        List of special equations: 
            Clock  = (ClockBlock_BUS_CLK) => Global
            Clock Enable: True
        Main Equation            : 1 pterm
        (
              \Timeout_1:TimerUDB:control_7\ * \Timeout_1:TimerUDB:per_zero\
        );
        Output = Net_207 (fanout=1)

    MacroCell: Name=Net_710, Mode=(D-Register)
        Total # of inputs        : 3
        Total # of product terms : 2
        List of special equations: 
            Clock  = (ClockBlock_BUS_CLK) => Global
            Clock Enable: True
        Main Equation            : 2 pterms
        (
              Net_710 * !Net_207
            + !Net_207 * Net_233
        );
        Output = Net_710 (fanout=3)

    MacroCell: Name=Net_421, Mode=(D-Register)
        Total # of inputs        : 3
