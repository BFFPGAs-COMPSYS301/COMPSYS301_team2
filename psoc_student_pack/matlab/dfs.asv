%% This is a shell that you will have to follow strictly. 
% You will use the plotmap() and viewmap() to display the outcome of your algorithm.

% Load sample_data_map_8, three variables will be created in your workspace. These were created as a 
% result of [m,v,s]=dfs('map_8.txt',[14,1],[1,18]);
% The solution can be viewed using 
% plotmap(m,s) 

% write your own function for the DFS algorithm.
function [retmap,retvisited,retsteps] = dfs(mapfile,startlocation,targetlocation)

    % Convert the map file into a MATLAB matrix
    map = map_convert(mapfile);
    retmap = map;

    % Get dimensions of the map
    [maprows,mapcols] = size(map);

    % Create a matrix to keep track of visited cells
    visited = false(maprows,mapcols);

    % Keep track of the parent of every visited cell.
    parent = zeros(maprows,mapcols,2);

    % DFS stack
    stack = startlocation;

    % Mark the starting location as visited
    visited(startlocation(1),startlocation(2)) = true;

    % Store the order in which cells were visited
    retvisited = [];

    % Used to indicate whether target has been found
    found = false;

    % Directions:
    %       up
    %       down
    %       left
    %       right
    directions = [
        -1  0
         1  0
         0 -1
         0  1
    ];

    % DFS
    while ~isempty(stack)

        % Take the last item from the stack
        current = stack(end,:);
        stack(end,:) = [];

        % Record that this cell was visited
        retvisited = [retvisited; current];

        % Have we reached the target?
        if current(1) == targetlocation(1) && current(2) == targetlocation(2)
            found = true;
            break;
        end

        % Check each neighbouring cell
        for k = 1:4

            neighbour = current + directions(k,:);

            row = neighbour(1);
            col = neighbour(2);

            % Check that neighbour is inside the map
            if row >= 1 && row <= maprows && col >= 1 && col <= mapcols

                % Check that it is not a wall
                if map(row,col) == 0

                    % Check that it hasn't already been visited
                    if ~visited(row,col)

                        % Mark as visited
                        visited(row,col) = true;

                        % Remember where we came from
                        parent(row,col,1) = current(1);
                        parent(row,col,2) = current(2);

                        % Add neighbour to stack
                        stack = [stack; neighbour];

                    end
                end
            end
        end
    end

    % Reconstruct the path from target back to start

    retsteps = [];

    if found

        current = targetlocation;

        while ~(current(1) == startlocation(1) && current(2) == startlocation(2))

            % Add current cell to the path
            retsteps = [current; retsteps];

            % Move to the parent
            parentrow = parent(current(1),current(2),1);
            parentcol = parent(current(1),current(2),2);

            current = [parentrow parentcol];
        end

        % Add the starting location
        retsteps = [startlocation; retsteps];

    end

plotmap(m)

end

function placestep(position,i)
% This function will plot a insert yellow rectangle and also print a number in this rectangle. Use with plotmap/viewmap. 
position = [16-position(1) position(2)];

position=[position(2)+0.1 position(1)+0.1];

rectangle('Position',[position,0.8,0.8],'FaceColor','y');

c=sprintf('%d',i);

text(position(1)+0.2,position(2)+0.2,c,'FontSize',10);

end
