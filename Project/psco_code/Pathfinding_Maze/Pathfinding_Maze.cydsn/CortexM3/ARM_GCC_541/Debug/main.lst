  16:main.c        **** {
  17:main.c        ****     "1111111111111111111",
  18:main.c        ****     "1010001000001000001",
  19:main.c        ****     "1011101011101011101",
  20:main.c        ****     "1000100000100000101",
  21:main.c        ****     "1110111111111111101",
  22:main.c        ****     "1010000010000000001",
  23:main.c        ****     "1011111010111111101",
  24:main.c        ****     "1000001000100000101",
  25:main.c        ****     "1010101111101110101",
  26:main.c        ****     "1010101000101010101",
  27:main.c        ****     "1110101010101010101",
  28:main.c        ****     "1000101010001010101",
  29:main.c        ****     "1011111011111010101",
  30:main.c        ****     "1000000000000010001",
  31:main.c        ****     "1111111111111111111"
  32:main.c        **** };
  33:main.c        **** 
  34:main.c        **** 
