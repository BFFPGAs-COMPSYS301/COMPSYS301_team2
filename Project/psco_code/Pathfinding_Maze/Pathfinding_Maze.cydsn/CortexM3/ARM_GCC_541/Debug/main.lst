  80:movements.c   **** static void MoveForwardOneCell(Command nextCommand)
  81:movements.c   **** {
  82:movements.c   ****     int16 travelled = 0;
  83:movements.c   ****     int16 timeout = 0;
  84:movements.c   **** 
  85:movements.c   ****     LED_1_Write(1);
  86:movements.c   ****     QuadDec_1_SetCounter(0);
  87:movements.c   **** 
  88:movements.c   ****     // Drive forward for one complete cell if going straight.
ARM GAS  C:\Users\mtay770\AppData\Local\Temp\ccBrkWuL.s 			page 3


  89:movements.c   ****     if (nextCommand == CMD_FORWARD)
  90:movements.c   ****     {
  91:movements.c   ****         while (travelled < CELL_LENGTH)
  92:movements.c   ****         {
  93:movements.c   ****             forwardFollowing();
  94:movements.c   ****             CyDelay(1);
  95:movements.c   ****             travelled = QuadDec_1_GetCounter();
  96:movements.c   ****         }
  97:movements.c   ****         
  98:movements.c   ****        // stopMoving(); //Stop at end of cell for debugging, remove for final version
  99:movements.c   ****         
 100:movements.c   ****     } else {  // If turning next, approach the intersection first.
 101:movements.c   ****         // Continue until the sensors detect the intersection.
 102:movements.c   ****         if (nextCommand == CMD_LEFT) {
 103:movements.c   ****             while (FrontLSensor_Read() && timeout < INTERSECTION_TIMEOUT)
 104:movements.c   ****             {
