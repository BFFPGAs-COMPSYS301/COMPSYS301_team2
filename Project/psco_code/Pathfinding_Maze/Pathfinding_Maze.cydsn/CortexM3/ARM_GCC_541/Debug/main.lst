  80:movements.c   **** static void MoveForwardOneCell(Command nextCommand)
  81:movements.c   **** {
  82:movements.c   ****     int16 travelled = 0;
  83:movements.c   ****     int16 timeout = 0;
  84:movements.c   **** 
  85:movements.c   ****     LED_1_Write(1);
  86:movements.c   ****     QuadDec_1_SetCounter(0);
  87:movements.c   **** 
  88:movements.c   ****     // Drive forward for one complete cell if going straight.
ARM GAS  C:\Users\aale517\AppData\Local\Temp\ccf8dnOM.s 			page 3


  89:movements.c   ****     if (nextCommand == CMD_FORWARD)
  90:movements.c   ****     {
  91:movements.c   ****         while (travelled < CELL_LENGTH)
  92:movements.c   ****         {
  93:movements.c   ****             forwardFollowing();
  94:movements.c   ****             CyDelay(1);
  95:movements.c   ****             travelled = QuadDec_1_GetCounter();
  96:movements.c   ****         }
  97:movements.c   ****         
  98:movements.c   ****        // stopMoving(); //Stop at end of cell for debugging, remove for final version
  99:movements.c   ****         
 100:movements.c   ****     } else {  // If turning next, approach the intersection first.
 101:movements.c   ****         // Continue until the sensors detect the intersection.
 102:movements.c   ****         if ((nextCommand == CMD_LEFT) || (nextCommand == CMD_LEFT_SHORT)) {
 103:movements.c   ****             while (FrontLSensor_Read() && timeout < INTERSECTION_TIMEOUT)
 104:movements.c   ****             {
 105:movements.c   ****                 findCorner();
 106:movements.c   ****                 CyDelay(1);
 107:movements.c   ****                 timeout++;
 108:movements.c   ****             }
 109:movements.c   ****         } else if ((nextCommand == CMD_RIGHT) || (nextCommand == CMD_RIGHT_SHORT)) {
 110:movements.c   ****             while (FrontRSensor_Read() && timeout < INTERSECTION_TIMEOUT)
 111:movements.c   ****             {
 112:movements.c   ****                 findCorner();
 113:movements.c   ****                 CyDelay(1);
 114:movements.c   ****                 timeout++;
 115:movements.c   ****             }
 116:movements.c   ****         }
 117:movements.c   ****     }
 118:movements.c   **** 
 119:movements.c   ****     // Stop the motors.
 120:movements.c   ****     PWM_1_WriteCompare(45);
 121:movements.c   ****     PWM_2_WriteCompare(45);
 122:movements.c   **** 
 123:movements.c   ****     LED_1_Write(0);
 124:movements.c   **** 
 125:movements.c   ****     //CyDelay(1000);
 126:movements.c   **** }
