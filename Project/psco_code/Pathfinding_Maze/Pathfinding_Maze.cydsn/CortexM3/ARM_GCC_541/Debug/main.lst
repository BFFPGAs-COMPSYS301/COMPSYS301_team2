  79:movements.c   **** static void MoveForwardOneCell(Command nextCommand)
  80:movements.c   **** {
  81:movements.c   ****     int16 travelled = 0;
  82:movements.c   ****     int16 timeout = 0;
  83:movements.c   **** 
  84:movements.c   ****     LED_1_Write(1);
  85:movements.c   ****     QuadDec_1_SetCounter(0);
  86:movements.c   **** 
  87:movements.c   ****     // Drive forward for one complete cell if going straight.
  88:movements.c   ****     if (nextCommand == CMD_FORWARD)
ARM GAS  C:\Users\mtay770\AppData\Local\Temp\ccOFXsqc.s 			page 3


  89:movements.c   ****     {
  90:movements.c   ****         while (travelled < CELL_LENGTH)
  91:movements.c   ****         {
  92:movements.c   ****             forwardFollowing();
  93:movements.c   ****             CyDelay(1);
  94:movements.c   ****             travelled = QuadDec_1_GetCounter();
  95:movements.c   ****         }
  96:movements.c   ****         
  97:movements.c   ****        // stopMoving(); //Stop at end of cell for debugging, remove for final version
  98:movements.c   ****         
  99:movements.c   ****     } else {  // If turning next, approach the intersection first.
 100:movements.c   ****         // Continue until the sensors detect the intersection.
 101:movements.c   ****         if ((nextCommand == CMD_LEFT) || (nextCommand == CMD_LEFT_SHORT)) {
 102:movements.c   ****             while (FrontLSensor_Read() && timeout < INTERSECTION_TIMEOUT)
 103:movements.c   ****             {
 104:movements.c   ****                 findCorner();
 105:movements.c   ****                 CyDelay(1);
 106:movements.c   ****                 timeout++;
 107:movements.c   ****             }
 108:movements.c   ****         } else if ((nextCommand == CMD_RIGHT) || (nextCommand == CMD_RIGHT_SHORT)) {
 109:movements.c   ****             while (FrontRSensor_Read() && timeout < INTERSECTION_TIMEOUT)
 110:movements.c   ****             {
 111:movements.c   ****                 findCorner();
 112:movements.c   ****                 CyDelay(1);
 113:movements.c   ****                 timeout++;
 114:movements.c   ****             }
 115:movements.c   ****         }
 116:movements.c   ****     }
 117:movements.c   **** 
 118:movements.c   ****     // Stop the motors.
 119:movements.c   ****     PWM_1_WriteCompare(45);
 120:movements.c   ****     PWM_2_WriteCompare(45);
 121:movements.c   **** 
 122:movements.c   ****     LED_1_Write(0);
 123:movements.c   **** 
 124:movements.c   ****     //CyDelay(1000);
 125:movements.c   **** }
