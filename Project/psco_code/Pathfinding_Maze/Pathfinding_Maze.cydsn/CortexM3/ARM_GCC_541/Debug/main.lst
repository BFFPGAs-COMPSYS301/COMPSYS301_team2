  32:movements.c   **** static void findCorner() {
  33:movements.c   ****     if (FrontSensor_Read() == 0) { // Front sensor is on the line
  34:movements.c   ****         offLineCount = 0;
  35:movements.c   ****         PWM_1_WriteCompare(FORWARD_SPEED - 1);
  36:movements.c   ****         PWM_2_WriteCompare(FORWARD_SPEED); // Drive right motor slightly slower so it gradually tur
  37:movements.c   ****     } else {
  38:movements.c   ****         if (offLineCount < 0) {
  39:movements.c   ****             rampingLeftBack();
  40:movements.c   ****         } else {
  41:movements.c   ****             goForwardSlow();
  42:movements.c   ****         }
  43:movements.c   ****         offLineCount++;
  44:movements.c   ****     }
  45:movements.c   **** }
