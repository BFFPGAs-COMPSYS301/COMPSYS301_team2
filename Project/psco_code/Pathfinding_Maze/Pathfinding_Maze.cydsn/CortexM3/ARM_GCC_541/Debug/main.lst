 112:movements.c   ****                 findCorner();
 113:movements.c   ****                 CyDelay(1);
 114:movements.c   ****                 timeout++;
 115:movements.c   ****             }
 116:movements.c   ****         }
 117:movements.c   ****     }
 118:movements.c   **** 
 119:movements.c   ****     // Stop the motors.
 120:movements.c   ****     PWM_1_WriteCompare(45);
 121:movements.c   ****     PWM_2_WriteCompare(45);
 122:movements.c   **** 
 123:movements.c   ****     LED_1_Write(0);
 124:movements.c   **** 
