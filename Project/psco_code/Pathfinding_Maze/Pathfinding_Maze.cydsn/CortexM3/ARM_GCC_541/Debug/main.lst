   4:main.c        **** /* =========================================================
   5:main.c        ****  * MAZE
   6:main.c        ****  *
   7:main.c        ****  * Paste the maze here exactly as provided.
   8:main.c        ****  *
   9:main.c        ****  * 0 = open
  10:main.c        ****  * 1 = wall
  11:main.c        ****  *
  12:main.c        ****  * The maze must be 15 rows x 19 columns.
  13:main.c        ****  * ========================================================= */
  14:main.c        **** 
