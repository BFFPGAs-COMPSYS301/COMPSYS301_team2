  33:movements.c   **** static void findCorner() {
  34:movements.c   ****     if (FrontSensor_Read() == 0) { // Front sensor is on the line
  35:movements.c   ****         offLineCount = 0;
  36:movements.c   ****         PWM_1_WriteCompare(FORWARD_SPEED - 1);
  37:movements.c   ****         PWM_2_WriteCompare(FORWARD_SPEED); // Drive right motor slightly slower so it gradually tur
  38:movements.c   ****     } else {
