  31:main.c        **** 
  32:main.c        **** /* =========================================================
  33:main.c        ****  * CHECKPOINTS
  34:main.c        ****  *
  35:main.c        ****  * IMPORTANT:
  36:main.c        ****  *
  37:main.c        ****  * Coordinates are ZERO-BASED.
  38:main.c        ****  *
  39:main.c        ****  * Top-left cell = {0,0}
  40:main.c        ****  *
  41:main.c        ****  * The order here is the order the robot will visit.
  42:main.c        ****  *
  43:main.c        ****  * points[0] MUST be the starting position.
  44:main.c        ****  * The final point is the final destination.
  45:main.c        ****  * ========================================================= */
  46:main.c        **** 
  47:main.c        **** Checkpoints checkpoints =
  48:main.c        **** {
  49:main.c        ****     .points =
  50:main.c        ****     {
  51:main.c        ****         /*
  52:main.c        ****         * NOTE: Co-ordinates are in format {Vertical, Horizontal}
  53:main.c        ****         */
  54:main.c        ****         {6, 6},     /* START */
  55:main.c        ****         {4, 2},
  56:main.c        ****         {8, 2},
  57:main.c        ****         {14, 7}/* END */
  58:main.c        ****     },
