  78:movements.c   **** static void MoveForwardOneCell(Command nextCommand)
  79:movements.c   **** {
  80:movements.c   ****     int16 travelled = 0;
  81:movements.c   ****     int16 timeout = 0;
  82:movements.c   **** 
  83:movements.c   ****     LED_1_Write(1);
  84:movements.c   ****     QuadDec_1_SetCounter(0);
  85:movements.c   **** 
  86:movements.c   ****     // Drive forward for one complete cell if going straight.
  87:movements.c   ****     if (nextCommand == CMD_FORWARD)
  88:movements.c   ****     {
  89:movements.c   ****         while (travelled < CELL_LENGTH)
  90:movements.c   ****         {
  91:movements.c   ****             forwardFollowing();
  92:movements.c   ****             CyDelay(1);
  93:movements.c   ****             travelled = QuadDec_1_GetCounter();
  94:movements.c   ****         }
  95:movements.c   ****         
  96:movements.c   ****        // stopMoving(); //Stop at end of cell for debugging, remove for final version
  97:movements.c   ****         
  98:movements.c   ****     } else {  // If turning next, approach the intersection first.
  99:movements.c   ****         // Continue until the sensors detect the intersection.
 100:movements.c   ****         if (nextCommand == CMD_LEFT) {
 101:movements.c   ****             while (FrontLSensor_Read() && timeout < INTERSECTION_TIMEOUT)
 102:movements.c   ****             {
 103:movements.c   ****                 findCorner();
 104:movements.c   ****                 CyDelay(1);
 105:movements.c   ****                 timeout++;
 106:movements.c   ****             }
 107:movements.c   ****         } else if (nextCommand == CMD_RIGHT) {
 108:movements.c   ****             while (FrontRSensor_Read() && timeout < INTERSECTION_TIMEOUT)
 109:movements.c   ****             {
 110:movements.c   ****                 findCorner();
 111:movements.c   ****                 CyDelay(1);
 112:movements.c   ****                 timeout++;
 113:movements.c   ****             }
 114:movements.c   ****         }
 115:movements.c   ****     }
 116:movements.c   **** 
 117:movements.c   ****     // Stop the motors.
 118:movements.c   ****     PWM_1_WriteCompare(45);
ARM GAS  C:\Users\mtay770\AppData\Local\Temp\cc5sWmMd.s 			page 4


 119:movements.c   ****     PWM_2_WriteCompare(45);
 120:movements.c   **** 
 121:movements.c   ****     LED_1_Write(0);
 122:movements.c   **** 
 123:movements.c   ****     //CyDelay(1000);
 124:movements.c   **** }
