   6:astar.c       **** // Manhatten Distance
   7:astar.c       **** static uint16_t Heuristic(
   8:astar.c       ****     Position a,
   9:astar.c       ****     Position b
  10:astar.c       **** )
  11:astar.c       **** {
  12:astar.c       ****     uint16_t rowDistance;
  13:astar.c       ****     uint16_t colDistance;
  14:astar.c       **** 
  15:astar.c       **** 
  16:astar.c       ****     if (a.row > b.row)
  17:astar.c       ****         rowDistance = a.row - b.row;
  18:astar.c       ****     else
  19:astar.c       ****         rowDistance = b.row - a.row;
  20:astar.c       **** 
  21:astar.c       **** 
  22:astar.c       ****     if (a.col > b.col)
  23:astar.c       ****         colDistance = a.col - b.col;
  24:astar.c       ****     else
  25:astar.c       ****         colDistance = b.col - a.col;
  26:astar.c       **** 
  27:astar.c       **** 
  28:astar.c       ****     return rowDistance + colDistance;
  29:astar.c       **** }
  30:astar.c       **** 
