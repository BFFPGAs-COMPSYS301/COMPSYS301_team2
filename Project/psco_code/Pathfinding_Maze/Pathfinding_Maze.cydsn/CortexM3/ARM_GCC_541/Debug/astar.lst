  10:astar.c       **** static uint16_t Heuristic(
  11:astar.c       ****     Position a,
  12:astar.c       ****     Position b
  13:astar.c       **** )
  14:astar.c       **** {
  15:astar.c       ****     uint16_t rowDistance;
  16:astar.c       ****     uint16_t colDistance;
  17:astar.c       **** 
  18:astar.c       **** 
  19:astar.c       ****     if (a.row > b.row)
  20:astar.c       ****         rowDistance = a.row - b.row;
  21:astar.c       ****     else
  22:astar.c       ****         rowDistance = b.row - a.row;
  23:astar.c       **** 
  24:astar.c       **** 
  25:astar.c       ****     if (a.col > b.col)
  26:astar.c       ****         colDistance = a.col - b.col;
  27:astar.c       ****     else
  28:astar.c       ****         colDistance = b.col - a.col;
  29:astar.c       **** 
  30:astar.c       **** 
  31:astar.c       ****     return rowDistance + colDistance;
